.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 日期切换卡片 */
.date-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(21, 101, 255, 0.08), rgba(122, 47, 242, 0.06));
  border: 1rpx solid #e8effc;
}

.date-arrow {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #1565ff;
  font-size: 24rpx;
  font-weight: 600;
}

.date-main {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.date-label {
  color: #101828;
  font-size: 40rpx;
  font-weight: 800;
}

.date-sub {
  color: #667085;
  font-size: 22rpx;
}

/* 卡片 */
.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-head {
  margin-bottom: 10rpx;
}

.card-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.loading-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #98a2b3;
  font-size: 26rpx;
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 5rpx solid #edf4ff;
  border-top-color: #1565ff;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-card {
  border-color: rgba(240, 68, 56, 0.25);
  background: #fffafa;
}

.error-text {
  color: #d92d20;
  font-size: 26rpx;
}

/* 大事列表 */
.event-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.event-row:last-child {
  border-bottom: none;
}

.event-year {
  flex-shrink: 0;
  min-width: 130rpx;
  margin-right: 20rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #edf4ff;
  color: #1565ff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.event-body {
  flex: 1;
}

.event-title {
  color: #101828;
  font-size: 26rpx;
  line-height: 1.7;
  font-weight: 600;
}

.event-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.6;
}

.source-note {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 20rpx;
}
