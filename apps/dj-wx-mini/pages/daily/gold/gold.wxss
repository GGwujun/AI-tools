.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 金价卡片 */
.gold-card {
  background: linear-gradient(135deg, #2c2f3e, #43475c);
}

.gold-card.sh {
  background: linear-gradient(135deg, #8a6d1f, #b8933a);
}

.gold-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.gold-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.gold-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.gold-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.gold-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
}

.gold-unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.gold-change {
  margin-top: 12rpx;
  font-size: 28rpx;
}

/* 红涨绿跌 */
.gold-change.up { color: #ff7d7d; }
.gold-change.down { color: #7ce2a0; }
.gold-change.flat { color: rgba(255, 255, 255, 0.7); }

.gold-extra {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

/* 换算器 */
.calc-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fffbe6;
  border-radius: 16rpx;
  padding: 24rpx;
}

.calc-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #b8860b;
}

.calc-unit {
  font-size: 26rpx;
  color: #999;
}

.calc-eq {
  font-size: 36rpx;
  color: #ccc;
}

.calc-result {
  min-width: 160rpx;
  text-align: right;
  font-size: 36rpx;
  font-weight: 700;
  color: #b8860b;
}

.calc-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
}

.loading-card {
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.footer-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
