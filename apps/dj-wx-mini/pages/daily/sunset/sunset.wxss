.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 地点行 */
.loc-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.loc-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.loc-label {
  font-size: 24rpx;
  color: #999;
}

.loc-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.loc-change {
  font-size: 26rpx;
  color: #2563ff;
  background: #edf4ff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

/* 分段选择 */
.seg-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.seg {
  flex: 1;
  display: flex;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  padding: 12rpx 0;
}

.seg-item.active {
  background: #fff;
  color: #ff5a3c;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 评分卡（按等级渐变） */
.score-card {
  color: #fff;
  background: linear-gradient(135deg, #64748b, #94a3b8);
}

.score-card.g-max { background: linear-gradient(135deg, #dc2626, #f97316); }
.score-card.g-big { background: linear-gradient(135deg, #ea580c, #f59e0b); }
.score-card.g-mid { background: linear-gradient(135deg, #d97706, #eab308); }
.score-card.g-small { background: linear-gradient(135deg, #475569, #64748b); }
.score-card.g-none { background: linear-gradient(135deg, #6b7280, #9ca3af); }

.score-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-num-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1;
}

.score-max {
  font-size: 28rpx;
  opacity: 0.7;
}

.score-grade-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.score-grade {
  font-size: 40rpx;
  font-weight: 700;
}

.score-countdown {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.score-tip {
  display: block;
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 日出日落 */
.sun-row {
  display: flex;
  gap: 12rpx;
}

.sun-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 14rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.sun-label {
  font-size: 22rpx;
  opacity: 0.8;
}

.sun-value {
  font-size: 28rpx;
  font-weight: 600;
}

/* 逐小时云量 */
.cloud-legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot.low { background: #94a3b8; }
.dot.mid { background: #f97316; }
.dot.high { background: #eab308; }

.legend-score {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.cloud-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.cloud-row:last-child {
  border-bottom: none;
}

.cloud-time {
  width: 90rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.cloud-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bar {
  height: 12rpx;
  background: #f1f2f4;
  border-radius: 6rpx;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s;
}

.low-fill { background: #94a3b8; }
.mid-fill { background: #f97316; }
.high-fill { background: #eab308; }

.cloud-score {
  width: 64rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: #ff5a3c;
}

.cloud-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
}

.loading-card {
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.footer-note {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
