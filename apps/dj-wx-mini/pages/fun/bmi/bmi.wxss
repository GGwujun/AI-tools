.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.form-label {
  flex-shrink: 0;
  width: 100rpx;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-unit {
  flex-shrink: 0;
  color: #98a2b3;
  font-size: 26rpx;
}

.go-btn {
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx 0;
}

.result-card {
  border-color: rgba(21, 101, 255, 0.18);
}

.bmi-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0 26rpx;
}

.bmi-num {
  font-size: 110rpx;
  font-weight: 800;
  line-height: 1.1;
}

.bmi-tag {
  padding: 8rpx 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* 分段刻度 */
.gauge {
  margin: 10rpx 6rpx 0;
}

.gauge-track {
  position: relative;
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2f6df6 0%, #10b981 25%, #f59e0b 50%, #ef4444 75%, #ef4444 100%);
}

.gauge-needle {
  position: absolute;
  top: -8rpx;
  width: 6rpx;
  height: 36rpx;
  border-radius: 4rpx;
  background: #101828;
  transform: translateX(-50%);
}

.gauge-labels {
  display: flex;
  margin-top: 12rpx;
}

.gl {
  flex: 1;
  text-align: center;
  color: #98a2b3;
  font-size: 22rpx;
}

.stat-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f4f7;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-num {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.stat-label {
  color: #98a2b3;
  font-size: 22rpx;
}

.tip-line {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.note {
  display: block;
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 20rpx;
  text-align: center;
}
