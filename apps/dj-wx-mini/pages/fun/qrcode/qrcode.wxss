.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.qr-input {
  width: 100%;
  min-height: 110rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.row-gap {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  font-size: 24rpx;
  color: #2563ff;
  background: #edf4ff;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.opt-row {
  display: flex;
  gap: 20rpx;
}

.opt-chip {
  padding: 14rpx 36rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #666;
}

.opt-chip.active {
  background: #7c3aed;
  color: #fff;
  font-weight: 600;
}

.gen-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(124, 58, 237, 0.3);
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-wrap {
  width: 420rpx;
  height: 420rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
  overflow: hidden;
}

.qr-wrap.loading {
  opacity: 0.5;
}

.qr-image {
  width: 100%;
  height: 100%;
}

.qr-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.action-btn {
  font-size: 28rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 32rpx;
  padding: 14rpx 44rpx;
}

.action-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  font-weight: 600;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.history-row:last-child {
  border-bottom: none;
}

.history-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.history-use {
  font-size: 24rpx;
  color: #7c3aed;
  flex-shrink: 0;
}

.footer-note {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
