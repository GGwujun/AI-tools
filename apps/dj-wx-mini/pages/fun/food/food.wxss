.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 转盘 */
.wheel-wrap {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin: 30rpx auto 40rpx;
}

.pointer {
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 44rpx solid #ff5a3c;
  z-index: 10;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.25));
}

.wheel {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: transform 3.2s cubic-bezier(0.22, 0.1, 0.15, 1);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
}

.wheel-item {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
}

.wheel-name {
  margin-top: 34rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
  max-width: 120rpx;
  overflow: hidden;
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
  z-index: 5;
}

.wheel-go {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff5a3c;
}

/* 结果 */
.result-card {
  text-align: center;
  padding: 44rpx 30rpx;
  background: #fff;
}

.result-card.show {
  background: linear-gradient(135deg, #fff5f0, #ffe8db);
}

.result-title {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.result-name {
  display: block;
  font-size: 72rpx;
  font-weight: 800;
  color: #ff5a3c;
}

.result-empty {
  font-size: 30rpx;
  color: #999;
}

/* 自定义 */
.add-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.add-btn {
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #ff5a3c;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.custom-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.custom-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff0f0;
  color: #ff5a3c;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
}

.custom-del {
  font-size: 30rpx;
  color: #ffaa99;
  padding: 0 4rpx;
}

.custom-empty {
  font-size: 24rpx;
  color: #bbb;
}

/* 历史 */
.history-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.history-chip {
  font-size: 26rpx;
  color: #333;
  background: #f5f6f8;
  border-radius: 10rpx;
  padding: 8rpx 22rpx;
}
