.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.today-label {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.add-btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #1565ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-title {
  display: block;
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-label {
  flex-shrink: 0;
  width: 90rpx;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #101828;
}

.repeat-chips {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.repeat-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
}

.repeat-chip.active {
  background: #edf4ff;
  color: #1565ff;
  font-weight: 600;
  border: 1rpx solid rgba(21, 101, 255, 0.35);
}

.save-btn {
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 0;
}

/* 常用倒数日 */
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.preset-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 18rpx 0 14rpx;
  border-radius: 18rpx;
  background: #f7f8fa;
  border: 1rpx solid transparent;
}

.preset-item.added {
  opacity: 0.45;
}

.preset-icon {
  font-size: 40rpx;
}

.preset-name {
  color: #101828;
  font-size: 22rpx;
  font-weight: 600;
}

.preset-days {
  color: #1565ff;
  font-size: 20rpx;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 70rpx 28rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-sub {
  color: #98a2b3;
  font-size: 24rpx;
}

/* 我的倒数日 */
.item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-card.today {
  border-color: rgba(240, 68, 56, 0.3);
  background: #fffafa;
}

.item-name {
  display: block;
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.item-date {
  display: block;
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.item-ops {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 14rpx;
}

.share-mini {
  margin: 0;
  padding: 4rpx 22rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1565ff;
  font-size: 22rpx;
  font-weight: 600;
}

.item-del {
  color: #98a2b3;
  font-size: 22rpx;
}

.item-days {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.days-num {
  color: #1565ff;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
}

.days-num.is-today {
  font-size: 72rpx;
}

.days-label {
  color: #98a2b3;
  font-size: 22rpx;
}
