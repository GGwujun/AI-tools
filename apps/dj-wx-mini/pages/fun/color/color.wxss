.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 预览 */
.preview {
  height: 240rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx solid #eef2f6;
  transition: background 0.15s;
}

.preview-hex {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-title {
  display: block;
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

/* 滑杆 */
.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.slider-label {
  width: 110rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.slider-label.r { color: #e14141; }
.slider-label.g { color: #10b981; }
.slider-label.b { color: #2f6df6; }

.slider {
  flex: 1;
  margin: 0;
}

.hex-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.hex-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 28rpx;
  font-family: monospace;
}

.hex-apply {
  padding: 16rpx 34rpx;
  border-radius: 16rpx;
  background: #edf4ff;
  color: #1565ff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 代码行 */
.code-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  margin-bottom: 16rpx;
}

.code-label {
  width: 80rpx;
  color: #98a2b3;
  font-size: 24rpx;
  font-weight: 700;
}

.code-value {
  flex: 1;
  color: #101828;
  font-size: 28rpx;
  font-family: monospace;
  word-break: break-all;
}

.code-copy {
  color: #1565ff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 常用色 */
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 0;
}

.preset-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.preset-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  border: 1rpx solid #eef2f6;
}

.preset-name {
  color: #475467;
  font-size: 22rpx;
}
