.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat-chip {
  display: inline-block;
  padding: 10rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.cat-chip.active {
  background: #ff5a3c;
  color: #fff;
  font-weight: 600;
}

.pun-card {
  background: linear-gradient(135deg, #fff5f0, #ffe8db);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pun-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.6;
}

.pun-cat {
  font-size: 24rpx;
  color: #ff5a3c;
}

.pun-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.pun-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
  padding: 16rpx 0;
}

.pun-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff8a5c, #ff5a3c);
  font-weight: 600;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.history-row:last-child {
  border-bottom: none;
}

.history-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}

.history-copy {
  font-size: 24rpx;
  color: #2563ff;
  flex-shrink: 0;
}

.footer-note {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
