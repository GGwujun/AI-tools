<!-- 全屏弹幕层 -->
<view wx:if="{{fullscreen}}" class="dm-screen" bindtap="stop">
  <view class="dm-track">
    <text class="dm-text" style="color: {{activeColor}}; font-size: {{activeSize}}rpx; animation-duration: {{activeDuration}}s;">{{text}}</text>
  </view>
  <text class="dm-exit-hint">点击屏幕退出</text>
</view>

<!-- 编辑界面（自定义导航） -->
<view class="page" wx:else>
  <view class="fake-nav">
    <view class="fake-nav-row">
      <text class="fake-nav-back" hover-class="press" bindtap="goBack">‹</text>
      <text class="fake-nav-title">手持弹幕</text>
      <view class="fake-nav-space"></view>
    </view>
  </view>
  <scroll-view scroll-y class="content">

    <view class="card">
      <text class="card-title">弹幕内容</text>
      <textarea
        class="dm-input"
        placeholder="输入要显示的文字，如：某某某我爱你 / 前排接机 / 生日快乐"
        value="{{text}}"
        bindinput="onInput"
        maxlength="60"
        auto-height
      ></textarea>
    </view>

    <view class="card">
      <text class="card-title">文字颜色</text>
      <view class="opt-row">
        <view
          wx:for="{{colors}}"
          wx:key="value"
          class="color-dot {{colorIndex === index ? 'active' : ''}}"
          style="background: {{item.value}};"
          bindtap="setColor"
          data-index="{{index}}"
        ></view>
      </view>
    </view>

    <view class="card">
      <text class="card-title">文字大小</text>
      <view class="opt-row">
        <view
          wx:for="{{sizes}}"
          wx:key="value"
          class="opt-chip {{sizeIndex === index ? 'active' : ''}}"
          bindtap="setSize"
          data-index="{{index}}"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="card">
      <text class="card-title">滚动速度</text>
      <view class="opt-row">
        <view
          wx:for="{{speeds}}"
          wx:key="value"
          class="opt-chip {{speedIndex === index ? 'active' : ''}}"
          bindtap="setSpeed"
          data-index="{{index}}"
        >{{item.name}}</view>
      </view>
    </view>

    <button class="start-btn" bindtap="start">🚀 开始弹幕</button>

    <view class="footer-note">
      <text>开始后屏幕常亮，点击屏幕退出</text>
    </view>
  </scroll-view>
</view>
<back-home />
