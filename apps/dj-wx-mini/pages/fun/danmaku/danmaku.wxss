.page {
  min-height: 100vh;
  background: #f7f8fa;
  box-sizing: border-box;
}

/* 自定义标题栏（navigationStyle: custom） */
.fake-nav {
  padding: 100rpx 30rpx 24rpx;
  background: #f7f8fa;
}

.fake-nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.dm-input {
  width: 100%;
  min-height: 120rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.opt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

/* 颜色圆点 */
.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #f0f0f0;
  box-sizing: border-box;
}

.color-dot.active {
  border-color: #2563ff;
  transform: scale(1.12);
}

.opt-chip {
  padding: 14rpx 36rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #666;
}

.opt-chip.active {
  background: #2c2f3e;
  color: #ffd54a;
  font-weight: 600;
}

.start-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #4f9cff, #2563ff);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  margin: 20rpx 0 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(37, 99, 255, 0.35);
}

.footer-note {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 40rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* ---------------- 全屏弹幕 ---------------- */
.dm-screen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  z-index: 999;
  overflow: hidden;
}

.dm-track {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.dm-text {
  font-weight: 800;
  white-space: nowrap;
  animation: dm-marquee linear infinite;
}

@keyframes dm-marquee {
  from { transform: translateX(100vw); }
  to { transform: translateX(-100%); }
}

.dm-exit-hint {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}
