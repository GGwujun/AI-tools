.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.today-label {
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.add-btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #1565ff;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-label {
  flex-shrink: 0;
  width: 90rpx;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-value {
  color: #101828;
}

.form-note {
  color: #98a2b3;
  font-size: 24rpx;
}

.save-btn {
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 0;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 80rpx 28rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-sub {
  color: #98a2b3;
  font-size: 24rpx;
}

.item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-card.today {
  border-color: rgba(240, 68, 56, 0.3);
  background: #fffafa;
}

.item-name {
  display: block;
  color: #101828;
  font-size: 30rpx;
  font-weight: 700;
}

.item-date {
  display: block;
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.item-badge {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1565ff;
  font-size: 26rpx;
  font-weight: 700;
}

.item-badge.is-today {
  background: #fee4e2;
  color: #b42318;
}

.item-del {
  color: #98a2b3;
  font-size: 22rpx;
}
