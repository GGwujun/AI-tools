.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.intro {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  border: none;
}

.intro-text {
  font-size: 26rpx;
  color: #4f46e5;
  line-height: 1.7;
}

.char-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.char-preview {
  width: 110rpx;
  height: 110rpx;
  background: #f8f9fa;
  border: 2rpx dashed #d5d8e0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.char-glyph {
  font-size: 44rpx;
}

.char-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.char-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.char-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.char-hot {
  font-size: 20rpx;
  color: #ff5a3c;
  background: #fff0f0;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.char-code {
  font-size: 22rpx;
  color: #999;
}

.char-note {
  font-size: 24rpx;
  color: #666;
}

.char-copy {
  font-size: 26rpx;
  color: #2563ff;
  background: #edf4ff;
  border-radius: 24rpx;
  padding: 10rpx 26rpx;
  flex-shrink: 0;
}

.footer-note {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
