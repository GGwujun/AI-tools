.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.upload-area {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx dashed #ddd;
}

.upload-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
}

.preview-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 100%;
  max-height: 500rpx;
  border-radius: 16rpx;
}

.change-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #52c41a;
}

.go-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #7dd3a0, #52c41a);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(82, 196, 26, 0.35);
}

.go-btn.loading {
  opacity: 0.7;
  color: #fff;
}

/* 总热量 */
.total-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #ff9a44, #ff6a00);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
}

.total-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.total-right {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.total-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
}

.total-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.food-list {
  margin-bottom: 10rpx;
}

.food-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.food-row:last-child {
  border-bottom: none;
}

.food-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.food-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.food-portion {
  font-size: 22rpx;
  color: #999;
}

.food-kcal {
  font-size: 30rpx;
  color: #ff6a00;
  font-weight: 700;
}

.advice-box {
  margin-top: 20rpx;
  background: #f0fdf4;
  border-radius: 14rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.advice-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #52c41a;
}

.advice-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
}

.raw-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.footer-note {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 30rpx;
  font-size: 22rpx;
  color: #bbb;
}
