<view class="page">
  <scroll-view scroll-y class="content">

    <!-- 上传 -->
    <view class="card">
      <view wx:if="{{!image}}" class="upload-area" bindtap="chooseImage">
        <text class="upload-icon">🍔</text>
        <text class="upload-text">拍一张食物照片</text>
        <text class="upload-tip">支持拍摄或从相册选择</text>
      </view>
      <view wx:else class="preview-area">
        <image class="preview-image" src="{{image}}" mode="aspectFit" bindtap="chooseImage"></image>
        <text class="change-btn" bindtap="chooseImage">点击更换照片</text>
      </view>
    </view>

    <button class="go-btn {{isAnalyzing ? 'loading' : ''}}" bindtap="start" disabled="{{isAnalyzing || !image}}">
      {{isAnalyzing ? 'AI 正在识别…' : '🔥 开始算热量'}}
    </button>

    <!-- 结果 -->
    <view class="card" wx:if="{{items.length}}">
      <view class="total-box">
        <text class="total-num">{{total}}</text>
        <view class="total-right">
          <text class="total-unit">千卡 kcal</text>
          <text class="total-label">这一餐的估算总热量</text>
        </view>
      </view>

      <view class="food-list">
        <view wx:for="{{items}}" wx:key="index" class="food-row">
          <view class="food-info">
            <text class="food-name">{{item.name}}</text>
            <text class="food-portion">{{item.portion}}</text>
          </view>
          <text class="food-kcal">{{item.kcal}} 千卡</text>
        </view>
      </view>

      <view class="advice-box" wx:if="{{advice}}">
        <text class="advice-label">💡 饮食建议</text>
        <text class="advice-text">{{advice}}</text>
      </view>
    </view>

    <!-- 兜底原文展示 -->
    <view class="card" wx:if="{{rawText}}">
      <text class="card-title">识别结果</text>
      <text class="raw-text">{{rawText}}</text>
    </view>

    <view class="footer-note" wx:if="{{items.length}}">
      <text>估算结果仅供参考，实际热量因分量和做法而异</text>
    </view>
  </scroll-view>
</view>
