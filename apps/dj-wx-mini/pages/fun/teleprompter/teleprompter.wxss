/* 编辑模式 */
.page {
  height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-head.gap-top {
  margin-top: 30rpx;
}

.card-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.card-count {
  color: #98a2b3;
  font-size: 22rpx;
}

.script-input {
  width: 100%;
  min-height: 260rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 26rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}

.chip.active {
  background: #edf4ff;
  color: #1565ff;
  border-color: rgba(21, 101, 255, 0.35);
  font-weight: 600;
}

.go-btn {
  margin: 8rpx 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 0;
}

.tips {
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 2;
}

/* 播放模式 */
.player {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #000;
}

.player-viewport {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  padding: 0 34rpx;
  box-sizing: border-box;
}

.script-text {
  color: #fff;
  font-weight: 700;
  line-height: 1.8;
  letter-spacing: 2rpx;
  text-align: left;
  will-change: transform;
}

/* 顶部控制条 */
.player-top {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.player-bottom {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.p-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  backdrop-filter: blur(6rpx);
}

.p-btn.primary {
  background: rgba(21, 101, 255, 0.85);
}

.p-speed {
  min-width: 72rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 600;
}

/* 进度条 */
.progress-bar {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.12);
}

.progress-inner {
  height: 100%;
  background: #1565ff;
  border-radius: 0 6rpx 6rpx 0;
  transition: width 0.3s linear;
}
