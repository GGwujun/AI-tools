.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-title {
  display: block;
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.card-title.mt {
  margin-top: 34rpx;
}

/* 结果 */
.result-card {
  border-color: rgba(21, 101, 255, 0.18);
}

.pwd-box {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  text-align: center;
}

.pwd-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  letter-spacing: 4rpx;
  word-break: break-all;
  line-height: 1.5;
}

.strength-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.strength-bars {
  display: flex;
  gap: 10rpx;
}

.bar {
  width: 60rpx;
  height: 12rpx;
  border-radius: 8rpx;
  background: #eef2f6;
}

.bar.on.l1 { background: #f87171; }
.bar.on.l2 { background: #fbbf24; }
.bar.on.l3 { background: #34d399; }
.bar.on.l4 { background: #10b981; }

.strength-label {
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-row button {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 0;
}

.ghost-btn {
  background: #edf4ff;
  color: #1565ff;
}

.primary-btn {
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
}

.tip {
  display: block;
  margin-top: 20rpx;
  color: #98a2b3;
  font-size: 22rpx;
  text-align: center;
}

/* 选项 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 26rpx;
}

.chip.active {
  background: #edf4ff;
  color: #1565ff;
  font-weight: 700;
  border: 1rpx solid rgba(21, 101, 255, 0.35);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.switch-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.switch-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
}

.switch-sub {
  color: #98a2b3;
  font-size: 22rpx;
}
