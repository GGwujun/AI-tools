<view class="page">
  <scroll-view scroll-y class="content">

    <!-- 结果卡 -->
    <view class="card result-card">
      <view class="pwd-box" bindtap="copy">
        <text class="pwd-text" user-select>{{password || '点下方按钮生成'}}</text>
      </view>
      <view class="strength-row">
        <view class="strength-bars">
          <view class="bar {{strength.level >= 1 ? 'on l1' : ''}}"></view>
          <view class="bar {{strength.level >= 2 ? 'on l2' : ''}}"></view>
          <view class="bar {{strength.level >= 3 ? 'on l3' : ''}}"></view>
          <view class="bar {{strength.level >= 4 ? 'on l4' : ''}}"></view>
        </view>
        <text class="strength-label">{{strength.label}}</text>
      </view>
      <view class="btn-row">
        <button class="ghost-btn" bindtap="copy">复制</button>
        <button class="primary-btn" bindtap="regenerate">重新生成</button>
      </view>
      <text class="tip">密码只在本机生成，不会上传服务器</text>
    </view>

    <!-- 设置 -->
    <view class="card">
      <view class="card-title">密码长度</view>
      <view class="chip-row">
        <view
          wx:for="{{lengths}}"
          wx:key="*this"
          class="chip {{opts.length === item ? 'active' : ''}}"
          bindtap="setLength"
          data-length="{{item}}"
        >{{item}} 位</view>
      </view>

      <view class="card-title mt">字符类型</view>
      <view class="chip-row">
        <view
          wx:for="{{toggles}}"
          wx:key="key"
          class="chip {{opts[item.key] ? 'active' : ''}}"
          bindtap="toggleSet"
          data-key="{{item.key}}"
        >{{item.label}}</view>
      </view>

      <view class="switch-row" bindtap="toggleAmbiguous">
        <view class="switch-text">
          <text class="switch-title">去掉易混淆字符</text>
          <text class="switch-sub">排除 i l o 0 1 等长得像的字符</text>
        </view>
        <switch checked="{{opts.noAmbiguous}}" color="#1565ff" catchchange="toggleAmbiguous" />
      </view>
    </view>

  </scroll-view>
</view>
