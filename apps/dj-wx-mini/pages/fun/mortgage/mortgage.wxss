.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.content {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 顶部 tab */
.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: #667085;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #eef2f6;
}

.tab-item.active {
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  border-color: transparent;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.form-label {
  flex-shrink: 0;
  width: 140rpx;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 26rpx;
}

.form-unit {
  flex-shrink: 0;
  color: #98a2b3;
  font-size: 26rpx;
}

.mode-chips {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.mode-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}

.mode-chip.active {
  background: #edf4ff;
  color: #1565ff;
  border-color: rgba(21, 101, 255, 0.35);
  font-weight: 600;
}

.go-btn {
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx 0;
}

.result-card {
  border-color: rgba(21, 101, 255, 0.18);
}

.main-row {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.main-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-num {
  color: #1565ff;
  font-size: 72rpx;
  font-weight: 800;
}

.main-label {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.decay-tip {
  display: block;
  text-align: center;
  margin-bottom: 20rpx;
  color: #b54708;
  font-size: 24rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f4f7;
}

.stat {
  width: calc(50% - 10rpx);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-num {
  color: #101828;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-label {
  color: #98a2b3;
  font-size: 22rpx;
}

.note {
  display: block;
  margin-top: 24rpx;
  color: #98a2b3;
  font-size: 20rpx;
  text-align: center;
}
