.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.05);
}

/* ============ 输入态 ============ */

.tool-head {
  display: flex;
  align-items: center;
}

.tool-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.tool-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.tool-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.tool-desc {
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 6rpx;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.5;
}

.field-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.ph {
  color: #b8c0ce;
}

.tip {
  font-size: 24rpx;
  color: #8a94a6;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.gen-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.gen-btn::after {
  border: none;
}

.gen-btn[disabled] {
  opacity: 0.6;
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.again-btn {
  margin-top: 8rpx;
}

/* ============ 错误卡 ============ */

.error-card {
  background: #fff5f5;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #d64545;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.retry-btn {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #d64545;
  color: #fff;
  font-size: 28rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}

/* ============ 生成中 ============ */

.running-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e5e9f2;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.running-text {
  font-size: 30rpx;
  color: #1a1a2e;
  margin-top: 28rpx;
}

.elapsed {
  font-size: 24rpx;
  color: #8a94a6;
  margin-top: 12rpx;
}

/* ============ 结果态 ============ */

.card-title {
  font-size: 24rpx;
  color: #8a94a6;
  margin-bottom: 16rpx;
}

.draft-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
}

.content-text {
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  padding: 8rpx 22rpx;
  background: #f0f2ff;
  color: #667eea;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* lines 条目 */
.line-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.line-item:last-child {
  border-bottom: none;
}

.line-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f2ff;
  color: #667eea;
  font-size: 24rpx;
  margin-right: 18rpx;
}

.line-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.6;
}

/* 操作按钮 */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.act-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  color: #667eea;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #667eea;
}

.act-btn::after {
  border: none;
}
