.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.card-header .card-title {
  margin-bottom: 0;
}

/* 来源视频 */
.source-banner {
  margin-bottom: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #f3ecff;
  border: 2rpx solid #e6d9ff;
}

.source-banner-text {
  color: #7a2ff2;
  font-size: 24rpx;
  font-weight: 600;
}

.source-url {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
  line-height: 1.6;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* input 显式高度 + 仅横向 padding（项目规范） */
.link-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f9fa;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.paste-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
}

.link-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* 平台选择 */
.platform-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.18s;
}

.platform-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: #667eea;
}

.platform-item.active .platform-name {
  color: #fff;
}

.platform-icon {
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.platform-name {
  font-size: 22rpx;
  color: #666;
}

/* 风格选择 */
.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.card .style-list:first-of-type {
  margin-top: 0;
}

.style-item {
  padding: 14rpx 28rpx;
  background: #f8f9fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 4rpx solid transparent;
  transition: all 0.18s;
}

.style-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-color: #667eea;
}

/* 主按钮 */
.generate-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
}

.generate-btn.slim {
  height: 84rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
  margin-bottom: 0;
}

/* 两阶段 loading */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(102, 126, 234, 0.15);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.state-sub {
  font-size: 24rpx;
  color: #999;
}

/* 错误卡 */
.error-card {
  background: #fff5f5;
  border: 2rpx solid #ffd6d6;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: #d64545;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.error-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 30rpx;
}

.action-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

/* 结果 */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-header .card-title {
  margin-bottom: 0;
}

.copy-btn {
  font-size: 26rpx;
  color: #667eea;
  flex-shrink: 0;
}

.copy-btn.center {
  display: block;
  margin: 20rpx auto 0;
  text-align: center;
}

.result-content {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.result-content.transcript {
  font-size: 26rpx;
  color: #555;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 历史 */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #999;
}

.history-item {
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-item:last-child {
  margin-bottom: 0;
}

.history-main {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.history-topic {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-platform {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
