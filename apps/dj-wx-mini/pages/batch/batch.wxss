.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top center, rgba(21, 101, 255, 0.06), transparent 28%),
    #f7f8fa;
}

.scroll {
  height: 100vh;
  padding: 20rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.hero-card,
.section-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(16, 24, 40, 0.04);
}

.input-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-placeholder-title {
  color: #1d2939;
  font-size: 26rpx;
  font-weight: 600;
}

.clear-text {
  color: #98a2b3;
  font-size: 22rpx;
}

.input-box {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1d2939;
}

.primary-btn {
  margin-top: 22rpx;
  height: 82rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #2c76ff 0%, #1565ff 100%);
  color: #fff;
}

.primary-btn.disabled {
  opacity: 0.6;
}

.primary-btn::after {
  border: none;
}

.helper-text {
  display: block;
  margin-top: 12rpx;
  color: #98a2b3;
  font-size: 20rpx;
  text-align: center;
}

.section-card {
  margin-top: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #1d2939;
  font-size: 26rpx;
  font-weight: 700;
}

.link-text {
  color: #1565ff;
  font-size: 22rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}

.task-item:last-child {
  border-bottom: none;
}

.task-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.task-cover-placeholder {
  background: #eef4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-cover-text {
  color: #1565ff;
  font-size: 30rpx;
  font-weight: 700;
}

.task-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-title {
  color: #1d2939;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-reason {
  color: #d92d20;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-platform {
  color: #98a2b3;
  font-size: 20rpx;
}

.task-status {
  font-size: 20rpx;
  font-weight: 600;
}

.task-status.pending {
  color: #98a2b3;
}

.task-status.running {
  color: #1565ff;
}

.task-status.success {
  color: #17b26a;
}

.task-status.failed {
  color: #d92d20;
}

.bottom-actions {
  margin-top: 20rpx;
}

.ghost-btn {
  height: 82rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 82rpx;
  background: #fff;
  color: #475467;
  border: 2rpx solid #e4e7ec;
}

.ghost-btn::after {
  border: none;
}
