<view class="page">
  <scroll-view scroll-y class="scroll safe-bottom">

    <!-- 工具说明 -->
    <view class="tool-header">
      <image class="tool-header-icon" src="{{toolIcon}}" mode="aspectFit"></image>
      <view class="tool-header-main">
        <text class="tool-header-name">{{toolName}}</text>
        <text class="tool-header-desc">{{toolDesc}}</text>
      </view>
    </view>

    <!-- 链接输入 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">视频链接</text>
      </view>
      <textarea
        class="url-input"
        value="{{sourceUrl}}"
        placeholder="{{placeholder}}"
        maxlength="1000"
        auto-height
        bindinput="onUrlInput"
      ></textarea>
    </view>

    <!-- 参数表单 -->
    <view wx:if="{{fields.length}}" class="card">
      <view class="card-head">
        <text class="card-title">参数设置</text>
      </view>

      <view wx:for="{{fields}}" wx:key="key" class="field-item">
        <block wx:if="{{item.type === 'choice'}}">
          <text class="field-label">{{item.label}}</text>
          <view class="choice-row">
            <view
              wx:for="{{item.options}}"
              wx:for-item="option"
              wx:key="value"
              class="choice-chip {{form[item.key] === option.value ? 'active' : ''}}"
              bindtap="onChoiceTap"
              data-key="{{item.key}}"
              data-value="{{option.value}}"
            >{{option.label}}</view>
          </view>
        </block>

        <block wx:else>
          <text class="field-label">{{item.label}}</text>
          <input
            class="field-input"
            type="{{item.type === 'number' ? 'digit' : 'text'}}"
            value="{{form[item.key]}}"
            placeholder="{{item.placeholder}}"
            maxlength="{{item.maxlength || 20}}"
            bindinput="onFieldInput"
            data-key="{{item.key}}"
          />
        </block>
      </view>

      <!-- 文字水印位置九宫格 -->
      <view wx:if="{{tool === 'watermark'}}" class="field-item">
        <text class="field-label">水印位置</text>
        <view class="position-grid">
          <view
            wx:for="{{positionRows}}"
            wx:for-item="row"
            wx:for-index="rowIndex"
            wx:key="rowIndex"
            class="position-row"
          >
            <view
              wx:for="{{row}}"
              wx:for-item="cell"
              wx:key="*this"
              class="position-cell {{position === cell ? 'active' : ''}}"
              bindtap="onPositionTap"
              data-id="{{cell}}"
            >
              <view class="position-dot"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 执行按钮 -->
    <button class="run-btn" bindtap="startProcess" disabled="{{running}}">
      {{running ? '处理中...' : '开始处理'}}
    </button>

    <!-- 处理中状态 -->
    <view wx:if="{{running}}" class="card status-card">
      <view class="status-spinner"></view>
      <view class="status-main">
        <text class="status-title">正在处理，请稍候</text>
        <text class="status-meta">已用时 {{elapsed}} 秒{{toolTip ? ' · ' + toolTip : ''}}</text>
      </view>
    </view>

    <!-- 失败 -->
    <view wx:if="{{error}}" class="card error-card">
      <text class="error-title">处理失败</text>
      <text class="error-detail">{{error}}</text>
      <button class="retry-btn" bindtap="retry">重新处理</button>
    </view>

    <!-- 结果：文字稿 -->
    <view wx:if="{{result && result.output_type === 'text'}}" class="card result-card">
      <view class="card-head">
        <text class="card-title">识别结果（约 {{result.duration}} 秒视频）</text>
      </view>
      <textarea class="text-result" value="{{result.text}}" maxlength="-1" auto-height disabled></textarea>
      <view class="btn-row">
        <button class="ghost-btn" bindtap="copyText">复制全文</button>
        <button class="primary-btn" bindtap="goWriter">AI 改写文案</button>
      </view>
    </view>

    <!-- 结果：文件 -->
    <view wx:if="{{result && result.output_type === 'file'}}" class="card result-card">
      <view class="file-meta">
        <image class="file-icon" src="{{toolIcon}}" mode="aspectFit"></image>
        <view class="file-main">
          <text class="file-name">{{result.filename}}</text>
          <text class="file-sub">{{result.sizeText}}{{result.duration ? ' · 约 ' + result.duration + ' 秒' : ''}}</text>
        </view>
      </view>
      <text wx:if="{{result.note}}" class="file-note">{{result.note}}</text>

      <view wx:if="{{tool === 'extract_audio'}}" class="btn-row">
        <button class="ghost-btn" bindtap="toggleAudio">{{audioPlaying ? '暂停试听' : '试听'}}</button>
        <button class="ghost-btn" bindtap="copyLink">复制链接</button>
        <button class="primary-btn" bindtap="saveResult">发给朋友</button>
      </view>
      <view wx:elif="{{tool === 'screenshot'}}" class="btn-row">
        <button class="ghost-btn" bindtap="previewImage">预览大图</button>
        <button class="primary-btn" bindtap="saveResult">保存到相册</button>
      </view>
      <view wx:else class="btn-row">
        <button class="ghost-btn" bindtap="copyLink">复制链接</button>
        <button class="ghost-btn" bindtap="shareResultFile">发给朋友</button>
        <button class="primary-btn" bindtap="saveResult">保存到相册</button>
      </view>
      <text class="result-tip">文件服务器保留 2 小时，请及时保存</text>
    </view>

    <!-- 结果：九宫格图片 -->
    <view wx:if="{{result && result.output_type === 'images'}}" class="card result-card">
      <view class="card-head">
        <text class="card-title">切图完成，点击可预览</text>
      </view>
      <view class="grid-preview">
        <image
          wx:for="{{result.imageUrls}}"
          wx:key="*this"
          class="grid-cell"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewGridImage"
          data-index="{{index}}"
        ></image>
      </view>
      <view class="btn-row">
        <button class="primary-btn full-btn" bindtap="saveResult">全部保存到相册</button>
      </view>
    </view>

  </scroll-view>
</view>
