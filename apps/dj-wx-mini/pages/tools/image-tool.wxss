.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.scroll {
  height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* 工具说明头部 */
.tool-header {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(21, 101, 255, 0.08), rgba(122, 47, 242, 0.06));
  border: 1rpx solid #e8effc;
}

.tool-header-icon {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  background: #fff;
}

.tool-header-name {
  display: block;
  color: #101828;
  font-size: 34rpx;
  font-weight: 700;
}

.tool-header-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 卡片 */
.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.04);
  border: 1rpx solid #eef2f6;
}

.card-head {
  margin-bottom: 20rpx;
}

.card-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

/* 选图网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.cell-img {
  width: 100%;
  height: 100%;
}

.cell-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 0 0 0 18rpx;
  background: rgba(16, 24, 40, 0.55);
  color: #fff;
  font-size: 28rpx;
}

.add-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #f7f8fa;
  border: 1rpx dashed #cbd5e1;
  box-sizing: border-box;
}

.add-sign {
  color: #98a2b3;
  font-size: 56rpx;
  line-height: 1;
}

.add-text {
  color: #98a2b3;
  font-size: 22rpx;
}

.image-tip {
  display: block;
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

/* 参数表单 */
.field-item {
  margin-bottom: 28rpx;
}

.field-item:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #475467;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #101828;
  font-size: 26rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.choice-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}

.choice-chip.active {
  background: #edf4ff;
  color: #1565ff;
  border-color: rgba(21, 101, 255, 0.35);
  font-weight: 600;
}

/* 水印位置九宫格 */
/* 改尺寸：自定义宽高输入 */
.size-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.size-input {
  flex: 1;
  text-align: center;
}

.size-x {
  color: #97a0b5;
  font-size: 30rpx;
}

.position-grid {
  display: inline-block;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
}

.position-row {
  display: flex;
}

.position-cell {
  width: 92rpx;
  height: 92rpx;
  margin: 6rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid #e4e7ec;
  display: flex;
  align-items: center;
  justify-content: center;
}

.position-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d0d5dd;
}

.position-cell.active {
  border-color: #1565ff;
  background: #edf4ff;
}

.position-cell.active .position-dot {
  background: #1565ff;
  width: 20rpx;
  height: 20rpx;
}

/* 执行按钮 */
.run-btn {
  margin: 8rpx 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 22rpx 0;
}

.run-btn[disabled] {
  opacity: 0.6;
  color: #fff;
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
}

/* 处理中 */
.status-card {
  display: flex;
  align-items: center;
}

.status-spinner {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  border: 6rpx solid #edf4ff;
  border-top-color: #1565ff;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.status-title {
  display: block;
  color: #101828;
  font-size: 28rpx;
  font-weight: 600;
}

.status-meta {
  display: block;
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

/* 失败 */
.error-card {
  border-color: rgba(240, 68, 56, 0.25);
  background: #fffafa;
}

.error-title {
  display: block;
  color: #d92d20;
  font-size: 28rpx;
  font-weight: 700;
}

.error-detail {
  display: block;
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.retry-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #fee4e2;
  color: #b42318;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 0;
}

/* 结果卡片 */
.result-card {
  border-color: rgba(21, 101, 255, 0.18);
}

.result-image {
  width: 100%;
  border-radius: 18rpx;
  background: #f7f8fa;
  margin-bottom: 18rpx;
}

.file-meta-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.file-name2 {
  color: #101828;
  font-size: 24rpx;
  font-weight: 600;
  word-break: break-all;
}

.file-sub2 {
  flex-shrink: 0;
  color: #98a2b3;
  font-size: 22rpx;
}

.file-note {
  display: block;
  margin: 0 0 8rpx;
  color: #b54708;
  font-size: 22rpx;
}

/* 按钮组 */
.btn-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.btn-row button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 0;
  line-height: 1.6;
}

.btn-row button + button {
  margin-left: 0;
}

.ghost-btn {
  background: #f2f4f7;
  color: #475467;
}

.primary-btn {
  background: linear-gradient(135deg, #1565ff, #7a2ff2);
  color: #fff;
}

.result-tip {
  display: block;
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 20rpx;
  text-align: center;
}
