.back-home {
  position: fixed;
  right: 28rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.78);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.3);
  z-index: 998;
}

.back-home-icon {
  font-size: 26rpx;
  line-height: 1;
}

.bh-press {
  opacity: 0.7;
}
